{
  "name": "nfl-buddy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-app.mjs",
    "dev": "pnpm prepare:data && vite --config web/vite.config.ts --host 0.0.0.0",
    "build": "pnpm prepare:data && tsc -p web/tsconfig.json && vite build --config web/vite.config.ts && node scripts/package-app.mjs",
    "preview": "vite preview --config web/vite.config.ts --host 0.0.0.0",
    "test": "vitest run --config web/vite.config.ts",
    "test:ui": "playwright test --config web/playwright.config.ts",
    "typecheck": "tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
